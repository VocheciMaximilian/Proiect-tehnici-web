{
  "name": "gateala",
  "version": "1.0.0",
  "description": "Site pentru retete de gatit pe placul pofticiosilor",
  "author": "Vocheci Maximilian",
  "keywords": [
    "retete culinare",
    "gatit usor",
    "retete rapide"
  ],
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build-css": "sass Resurse/Stiluri/style.scss Resurse/Stiluri/style.css && sass Resurse/Stiluri/custom.scss Resurse/Stiluri/custom.css",
    "watch-css": "sass --watch Resurse/Stiluri/style.scss:Resurse/Stiluri/style.css Resurse/Stiluri/custom.scss:Resurse/Stiluri/custom.css"
  },
  "dependencies": {
    "bootstrap": "^5.3.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
