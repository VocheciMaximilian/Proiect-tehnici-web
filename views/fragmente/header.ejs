<script>
// Functionalitatea de comutare a temei
document.addEventListener('DOMContentLoaded', function() {
    const themeToggleBtn = document.getElementById('theme-toggle-btn');
    const body = document.body;
    
    // Preia tema salvata din localStorage
    const savedTheme = localStorage.getItem('theme') || 'light';
    
    // Aplica tema salvata
    if (savedTheme === 'dark') {
        body.classList.add('theme-dark');
        body.classList.remove('theme-light');
        updateButtonText(true);
    } else {
        body.classList.add('theme-light');
        body.classList.remove('theme-dark');
        updateButtonText(false);
    }
    
    // Comuta tema la click pe buton
    themeToggleBtn.addEventListener('click', function() {
        if (body.classList.contains('theme-dark')) {
            // Comuta la tema lumina
            body.classList.remove('theme-dark');
            body.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            updateButtonText(false);
        } else {
            // Comuta la tema intuneric
            body.classList.remove('theme-light');
            body.classList.add('theme-dark');
            localStorage.setItem('theme', 'dark');
            updateButtonText(true);
        }
    });
    
    function updateButtonText(isDark) {
        const icon = themeToggleBtn.querySelector('i');
        const text = themeToggleBtn.querySelector('span');
        
        if (isDark) {
            icon.className = 'fa fa-sun-o';
            text.textContent = 'Light Mode';
        } else {
            icon.className = 'fa fa-moon-o';
            text.textContent = 'Dark Mode';
        }
    }
});

// BONUS 19: Orar vizibil pe orice pagina
// La click pe butonul Orar, se incarca fragmentul si se insereaza in body
function incarcaOrar() {
    // Daca exista deja, nu mai adauga
    if(document.getElementById('container-orar')){
        document.getElementById('container-orar').style.display = '';
        return;
    }
    fetch('/fragmente/orar')
        .then(r => r.text())
        .then(html => {
            const div = document.createElement('div');
            div.innerHTML = html;
            document.body.appendChild(div.firstElementChild);
        });
}
document.addEventListener('DOMContentLoaded', function() {
    const btnOrar = document.getElementById('btn-orar');
    if(btnOrar) btnOrar.onclick = incarcaOrar;
});
</script>
