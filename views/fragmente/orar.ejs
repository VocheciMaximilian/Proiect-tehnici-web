<% /* Fragment orar.ejs - BONUS 19 */ %>
<% const zile = [
  { nume: 'Luni', interval: '09:00 - 17:00' },
  { nume: 'Marți', interval: '09:00 - 17:00' },
  { nume: 'Miercuri', interval: '09:00 - 17:00' },
  { nume: 'Joi', interval: '09:00 - 17:00' },
  { nume: 'Vineri', interval: '09:00 - 15:00' },
  { nume: 'Sâmbătă', interval: '10:00 - 13:00' },
  { nume: 'Duminică', interval: 'Închis' }
]; %>
<div id="container-orar" style="max-width:400px; margin:1em auto; background:#fffbe6; border:2px solid #e6c200; border-radius:10px; box-shadow:0 2px 8px #0002; padding:1em; position:relative;">
  <button id="btn-inchide-orar" style="position:absolute; top:0.5em; right:0.5em; background:#e6c200; border:none; border-radius:50%; width:2em; height:2em; font-weight:bold; cursor:pointer;">&times;</button>
  <h3 style="text-align:center; margin-bottom:0.7em;">Orar Găteală</h3>
  <table id="tabel-orar" style="width:100%; border-collapse:collapse;">
    <thead>
      <tr>
        <th style="border-bottom:2px solid #e6c200;">Zi</th>
        <th style="border-bottom:2px solid #e6c200;">Interval</th>
      </tr>
    </thead>
    <tbody>
      <% zile.forEach((z, idx) => { %>
        <tr data-zi="<%= idx %>">
          <td><%= z.nume %></td>
          <td><%= z.interval %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <div id="status-orar" style="margin-top:1em; text-align:center; font-size:1.1em; font-weight:bold;">
    Firma este acum:
    <span id="status-deschis" style="color:#1a5;">DESCHISA</span>
  </div>
</div>
<script>
// BONUS 19: Marcare zi curenta si status deschis/inchis
(function(){
  var azi = new Date();
  var ziCurenta = azi.getDay() === 0 ? 6 : azi.getDay() - 1;
  var oraCurenta = azi.getHours() + azi.getMinutes()/60;
  var intervale = [
    [9, 17], [9, 17], [9, 17], [9, 17], [9, 15], [10, 13], null
  ];
  var tr = document.querySelector('#tabel-orar tbody').children;
  for(let i=0;i<tr.length;i++){
    tr[i].style.background = '';
    tr[i].style.fontWeight = '';
    if(i === ziCurenta){
      tr[i].style.background = '#ffe066';
      tr[i].style.fontWeight = 'bold';
    }
  }
  var deschis = false;
  if(intervale[ziCurenta]){
    var o1 = intervale[ziCurenta][0], o2 = intervale[ziCurenta][1];
    deschis = oraCurenta >= o1 && oraCurenta <= o2;
  }
  var status = document.getElementById('status-deschis');
  if(status){
    status.textContent = deschis ? 'DESCHISA' : 'INCHISA';
    status.style.color = deschis ? '#1a5' : '#b00';
  }
})();
// Inchidere container orar
setTimeout(function() {
  var c = document.getElementById('container-orar');
  if (c) c.style.display = 'none';
}, 15000);
var btn = document.getElementById('btn-inchide-orar');
if (btn) {
  btn.onclick = function() {
    var c = document.getElementById('container-orar');
    if (c) c.style.display = 'none';
  };
}
</script> 