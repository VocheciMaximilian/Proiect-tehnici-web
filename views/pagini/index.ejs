        <h2>Tabel cu 10 Retete</h2>
        <table>
            <caption>Recomandari Gateala</caption>
            <thead>
            <tr>
                <th>#</th>
                <th>Nume Reteta</th>
                <th>Categorie</th>
                <th>Timp (min)</th>
                <th>Observatii</th>
            </tr>
            </thead>
            <tbody>
            <tr><td>1</td><td>Bruschete cu rosii</td><td>Aperitive</td><td>15</td><td>Se servesc calde</td></tr>
            <tr><td>2</td><td>Salata de vinete</td><td>Aperitive</td><td>20</td><td>Se poate congela</td></tr>
            <tr><td>3</td><td>Tocanita de pui</td><td>Feluri Principale</td><td>45</td><td>Poate fi picanta</td></tr>
            <tr><td>4</td><td>Friptura de porc la cuptor</td><td>Feluri Principale</td><td>60</td><td>Se marineaza inainte</td></tr>
            <tr><td>5</td><td>Cheesecake cu fructe</td><td>Desert</td><td>30</td><td>Rapid si racoros</td></tr>
            <tr><td>6</td><td>Clatite cu ciocolata</td><td>Desert</td><td>20</td><td>Pentru toate varstele</td></tr>
            <tr><td>7</td><td>Omleta cu legume</td><td>Rapide</td><td>10</td><td>Ideala pentru mic dejun</td></tr>
            <tr><td>8</td><td>Sandvis cu sunca si cascaval</td><td>Rapide</td><td>5</td><td>Perfect pentru gustare</td></tr>
            <tr><td>9</td><td>Sarmale traditionale</td><td>Populare</td><td>90</td><td>Se servesc cu smantana</td></tr>
            <tr><td>10</td><td>Mici la gratar</td><td>Populare</td><td>15</td><td>Nelipsiti la gratar</td></tr>
            </tbody>
        </table>
    </section>
    <!-- ZONA 3: Calendar Evenimente -->
    <section id="zona3">
        <h2>Calendar Evenimente</h2>
        <table>
            <caption>Aprilie – Mai (Evenimente)</caption>
            <thead><tr><th>Luna</th><th>Data</th><th>Eveniment</th></tr></thead>
            <tbody>
            <tr><td>Aprilie</td><td>21</td><td>Floriile</td></tr>
            <tr><td>Aprilie</td><td>28</td><td>Vinerea Mare</td></tr>
            <tr><td>Aprilie</td><td>29</td><td>Sambata Mare</td></tr>
            <tr><td>Aprilie</td><td>30</td><td>Paste Ortodox</td></tr>
            <tr><td>Mai</td><td>01</td><td>A doua zi de Paste</td></tr>
