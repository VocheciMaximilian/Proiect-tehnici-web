    <!-- ZONA 4: Anunturi -->
    <section id="zona4">
        <h2>Anunturi</h2>
        <p>Aici puteti gasi ultimele anunturi legate de site si evenimente.</p>
    </section>

    <!-- ZONA 5: Utilizatori Online -->
    <section id="zona5">
        <h2>Utilizatori Online</h2>
        <p>Numarul de utilizatori conectati in acest moment: 42</p>
    </section>

    <!-- ZONA 6: Date despre utilizator si statistici -->
    <section id="zona6">
        <h2>Date despre utilizator si statistici</h2>
        <p>IP-ul tau: <%= ip %></p>
    </section>

    <!-- ZONA 7: Date despre site si server -->
    <section id="zona7">
        <h2>Date despre site si server</h2>
        <p>Informatii tehnice despre server, uptime si alte detalii relevante.</p>
    </section>

    <!-- ZONA 8: Sectiuni interne -->
    <section id="zona8">
    </section>
    </main>
</main>

<%- include('../fragmente/footer') %>
</body>
</html>

