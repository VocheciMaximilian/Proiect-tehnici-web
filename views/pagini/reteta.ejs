<%- include('../fragmente/head.ejs') %>
<%- include('../fragmente/header.ejs') %>
<div class="detaliu-reteta">
  <h1><%= reteta.nume %></h1>
  <% if (imagini && imagini.length > 1) { %>
    <div id="carouselImagini" class="carousel slide" data-bs-ride="carousel" style="max-width:400px; margin:auto;">
      <div class="carousel-inner">
        <% imagini.forEach(function(img, idx) { %>
          <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
            <img src="/<%= img %>" class="d-block w-100 img-reteta" alt="<%= reteta.nume %>" style="max-width:400px;">
          </div>
        <% }); %>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselImagini" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselImagini" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
    </div>
  <% } else if (imagini && imagini.length === 1) { %>
    <img src="/<%= imagini[0] %>" alt="<%= reteta.nume %>" class="img-reteta" style="max-width:400px;">
  <% } %>
  <p><%= reteta.descriere %></p>
  <p><strong>Categorie:</strong> <%= reteta.categorie %> / <%= reteta.subcategorie %></p>
  <p><strong>Mod categorizare:</strong> <%= reteta.mod_categorizare %></p>
  <p><strong>Pret:</strong> <%= reteta.pret %> lei</p>
  <p><strong>Timp preparare:</strong> <%= reteta.timp_preparare %> min</p>
  <p><strong>Portii:</strong> <%= reteta.portii %></p>
  <p><strong>Complexitate:</strong> <%= reteta.complexitate %></p>
  <p><strong>Ingrediente:</strong> <%= Array.isArray(reteta.ingrediente) ? reteta.ingrediente.join(', ') : reteta.ingrediente %></p>
  <p><strong>Echipamente:</strong> <%= Array.isArray(reteta.echipamente) ? reteta.echipamente.join(', ') : reteta.echipamente %></p>
  <p><strong>Este rapida:</strong> <%= reteta.este_rapida ? 'Da' : 'Nu' %></p>
  <p><strong>Aprecieri:</strong> <%= reteta.aprecieri %></p>
  <p><strong>Instructiuni:</strong> <%= reteta.instructiuni %></p>
</div>
<%- include('../fragmente/footer.ejs') %> 